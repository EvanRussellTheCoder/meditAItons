# Pinecone server-side upload credentials. Never expose these in Angular environment files.
PINECONE_API_KEY=replace-with-your-pinecone-api-key
PINECONE_INDEX=replace-with-your-index-name
PINECONE_INDEX_HOST=replace-with-your-index-host.svc.pinecone.io

# Optional. The uploader defaults to long-1862 when this is omitted.
PINECONE_NAMESPACE=long-1862

# Required when PINECONE_INDEX is a standard 1536-dimensional dense index.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Optional OpenAI embedding settings.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional server-side conversation routing settings.
OPENAI_ROUTER_MODEL=gpt-5.6-luna
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_CHAT_MODEL=gpt-5.6-sol

# Required by the localhost chatbot's meditation-scheduling action. Keep both server-side.
CAL_API_KEY=replace-with-your-cal-api-key
CAL_EVENT_TYPE_ID=replace-with-your-numeric-event-type-id

# Optional localhost API settings. The host is intentionally restricted to loopback.
MEDITATIONS_API_HOST=127.0.0.1
MEDITATIONS_API_PORT=3000

# Used by other backend features, not by ingestion, chat, or calendar scheduling.
DATABASE_URL=replace-with-your-database-url
